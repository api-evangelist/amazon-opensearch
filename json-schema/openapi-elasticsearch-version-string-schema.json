  "title": "ElasticsearchVersionString",
  "description": "ElasticsearchVersionString schema from Amazon OpenSearch Service API",
  "type": "string",
  "pattern": "^[0-9]{1}\\.[0-9]{1,2}$|^OpenSearch_[0-9]{1,2}\\.[0-9]{1,2}$|^OS_[0-9]{1,2}\\.[0-9]{1,2}$"
