      ]
    },
    "VpcOptions": {
      "allOf": [
        {
          "$ref": "#/components/schemas/VPCOptions"
        },
        {
          "description": "The security groups and/or subnets to add, remove, or modify."
        }
      ]
    }
  },
  "required": [
