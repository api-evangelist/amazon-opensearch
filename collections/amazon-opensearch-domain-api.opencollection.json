{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon Elasticsearch Service Domain API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Domain",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon OpenSearch List Domain Names",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://es.{region}.amazonaws.com/2015-01-01/domain",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "engineType",
                "value": "",
                "type": "query",
                "description": " Optional parameter to filter the output by domain engine type. Acceptable values are 'Elasticsearch' and 'OpenSearch'. "
              }
            ]
          },
          "docs": "Returns the name of all Elasticsearch domains owned by the current user's account. "
        },
        {
          "info": {
            "name": "Amazon OpenSearch List Packages for Domain",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://es.{region}.amazonaws.com/2015-01-01/domain/:DomainName/packages",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "DomainName",
                "value": "",
                "type": "path",
                "description": "The name of the domain for which you want to list associated packages."
              },
              {
                "name": "maxResults",
                "value": "",
                "type": "query",
                "description": "Limits results to a maximum number of packages."
              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query",
                "description": "Used for pagination. Only necessary if a previous API call includes a non-null NextToken value. If provided, returns results for the next page."
              },
              {
                "name": "MaxResults",
                "value": "",
                "type": "query",
                "description": "Pagination limit"
              },
              {
                "name": "NextToken",
                "value": "",
                "type": "query",
                "description": "Pagination token"
              }
            ]
          },
          "docs": "Lists all packages associated with the Amazon ES domain."
        }
      ]
    }
  ],
  "bundled": true
}